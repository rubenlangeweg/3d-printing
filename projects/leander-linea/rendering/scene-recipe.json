  "camera_shared": {
    "type": "ORTHO",
    "dof": false,
    "clip_start_mm": 0.1,
    "clip_end_combined_and_shelf_mm": 100000,
    "clip_end_organizer_mm": 10000,
    "aim_formula": "(target-camera.location).to_track_quat('-Z','Y').to_euler()",
    "position_formula": "theta = math.radians(azimuth_degrees); target + Vector((radius * math.cos(theta), radius * math.sin(theta), height))",
    "orthographic_note": "ortho_scale is the Blender camera property; do not rename it as a lens focal length.",
    "angle_unit": "degrees; convert to radians before trigonometric functions"
  },
  "motion_formula": {
    "combined": {
      "frames": 192,
      "u": "(frame-1)/191",
      "p": "max(0,(u-0.18)/0.82)",
      "e": "p*p*(3-2*p)",
      "target": "lerp((70,-30,490),(315,-95,860),e)",
      "azimuth_degrees": "-53+20*e",
      "radius_mm": "2535-1385*e",
      "height_mm": "1010-600*e",
      "ortho_scale": "1750-960*e",
      "opening": "Held initially until about18% of clip, then smooth push; actual table stays visible."
    },
    "shelf": {
      "frames": 144,
      "u": "(frame-1)/143",
      "e": "u*u*(3-2*u)",
      "target": "lerp((325,0,885),(350,20,900),e)",
      "azimuth_degrees": "-45+70*e",
      "radius_mm": "1300-250*e",
      "height_mm": "320-235*e",
      "ortho_scale": "620-140*e"
    },
    "organizer": {
      "frames": 144,
      "u": "(frame-1)/143",
      "e": "u*u*(3-2*u)",
      "target": "lerp((250,-160,785),(303,-212,880),e)",
      "azimuth_degrees": "-58+18*e",
      "radius_mm": "1500-350*e",
      "height_mm": "560-120*e",
      "ortho_scale": "820-220*e"
    },
    "keys": "Insert location, rotation_euler and camera.data.ortho_scale keys every frame. Saved F-curves are BEZIER with AUTO_CLAMPED handles; actual rendered frame values follow the explicit smoothstep formulas."
  },
  "encoding": {
    "container": "MP4",
    "codec": "H.264 High Auto Level",
    "max_keyframe_interval": 24,
    "frame_reordering": false,
    "audio_tracks": 0,
    "network_optimization": true,
    "validation": "Decode every frame; verify count/duration/resolution/fps; inspect decoded first/middle/last. Encoder bitrate targets differ byclip; not all were20Mbps."
  },
  "notes": [
    "The saved scene defaults differ from some final-output profiles; select the required camera and output settings before rendering.",
    "Coordinate values use millimetres. Keep the complete geometry, light and camera rig at this scale when using the listed power values.",
    "The original organizer scene stores metre-based vertices with a scale transform of 1000. Accepted exported STLs are already in millimetres.",
    "Colour values are raw Blender node inputs. Keep AgX, Medium High Contrast and exposure +0.2 together.",
    "Keep the actual Linea table visible in product views and preserve the accepted accessory geometry and mounting transforms.",
    "Complete table-containing scenes and packed reference textures remain local; this file contains only rendering settings.",
    "Final videos were encoded from numbered frames with the macOS AVFoundation encoder."
  ]
